{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Iniciar Servidor Local",
            "type": "shell",
            "command": "npx",
            "args": [
                "-y",
                "serve",
                ".",
                "-l",
                "8080"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Accepting connections at"
                }
            }
        }
    ]
}
